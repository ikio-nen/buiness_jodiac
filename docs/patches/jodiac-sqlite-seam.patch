+def main():
+    failed = 0
+    for name, fn in CHECKS:
+        shutil.rmtree(_TMP, ignore_errors=True)
+        try:
+            fn()
+        except Exception as e:
+            failed += 1
+            print(f"FAIL {name}: {type(e).__name__}: {e}")
+        else:
+            print(f"ok   {name}")
+    shutil.rmtree(_TMP, ignore_errors=True)
+    print(f"\n{len(CHECKS) - failed}/{len(CHECKS)} checks passed")
+    sys.exit(1 if failed else 0)
+
