# ==============================================================================
# JODIAC (JARVIS) — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to git.
# ==============================================================================

# ── Local Data & Paths ────────────────────────────────────────────────────────
# Defaults to jodiac_data inside the project folder
JODIAC_HOME=./jodiac_data
JODIAC_OBSIDIAN=./jodiac_data/obsidian

# ── Primary AI: Google Gemini ─────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.5-flash-lite

# ── Secondary AI: OpenCode / Vercel AI Provider (OpenAI-compatible) ───────────
# Active only when AI_PROVIDER is set to an OpenAI-compatible provider (or opencode/vercel)
AI_PROVIDER=gemini
AI_PROVIDER_KEY=your_secondary_ai_key_here
AI_PROVIDER_BASE_URL=https://YOUR_OPENCODE_OR_VERCEL_ENDPOINT/v1
AI_PROVIDER_MODEL=your_model_name_here

# ── Gmail SMTP Outreach ───────────────────────────────────────────────────────
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here
SENDER_NAME="The Team"

# ── Search & Intelligence ─────────────────────────────────────────────────────
EXA_API_KEY=your_exa_api_key_here

# ── Safety / Testing ──────────────────────────────────────────────────────────
# Set to 1 or true to stub all emails, search, enrichment, and AI calls
DRY_RUN=false

# ── Optional / Not Used by Default ────────────────────────────────────────────
# The following services are strictly optional. The app functions without them.
# Email fallbacks:
# RESEND_API_KEY=
# BREVO_API_KEY=
# OUTREACH_FROM_EMAIL=
#
# Alternative search & Places:
# TAVILY_API_KEY=
# GEOAPIFY_API_KEY=
# REACHER_URL=http://localhost:8080
#
# Contact enrichment & Maps scrapers:
# HUNTER_API_KEY=
# APOLLO_KEY=
# APIFY_TOKEN=
# OUTSCRAPER_KEY=
#
# Other third-party AI provider keys (unused):
# AI_PROVIDER_KEY_GROQ=
# AI_PROVIDER_KEY_DEEPSEEK=
# AI_PROVIDER_KEY_OPENROUTER=
# AI_PROVIDER_KEY_HUGGINGFACE=
# AI_PROVIDER_KEY_NVIDIA=
# AI_PROVIDER_KEY_MISTRAL=
# AI_PROVIDER_KEY_ZAI=

# Locations map tiles. The default is OpenStreetMap's volunteer tile servers,
# which need the app's Referer (sent per tile) and light use. Point MAP_TILE_URL
# at a keyed provider to move off them: {z}/{x}/{y} are required, {s} rotates
# subdomains, {r} is dropped, and the host named here is added to the page CSP
# automatically. Keep the credit complete for whichever provider you use.
# MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png
# MAP_TILE_ATTRIB=© OpenStreetMap contributors © CARTO
# MAP_TILE_ATTRIB_URL=https://carto.com/attributions
